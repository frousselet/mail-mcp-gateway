# =============================================================================
# Mail MCP Gateway - environment configuration
# =============================================================================
# EVERYTHING HERE IS OPTIONAL for the default (multi-user) deployment:
# `docker compose up` works with none of it. Users self-register with passkeys,
# create their own connectors and attach their own mailboxes through the web UI.
# -----------------------------------------------------------------------------

# Host port the web UI and the MCP endpoint are published on (default 8000).
# The MCP endpoint is then at http://<host>:<MCP_PORT>/mcp
# MCP_PORT=8000

# Recommended in production: the public https origin. When set it overrides
# request auto-detection, so the OAuth metadata and 401 hints match exactly.
# Passkeys require HTTPS (localhost excepted).
# MAIL_PUBLIC_URL=https://mail-mcp.example.com

# Override the auto-generated Fernet key (encrypts stored mailbox passwords,
# refresh tokens and OAuth client secrets).
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MAIL_SECRET_KEY=

# Where the encrypted store and the auto-generated key file live (container
# path, on the data volume).
# MAIL_STORE=/data/mail_connections.json

# Name shown in the passkey prompt.
# MAIL_RP_NAME=Mail MCP Gateway

# Require an invite code to self-register and to create connectors.
# MAIL_ONBOARD_CODE=

# Override the OAuth redirect allow-list (comma-separated). Defaults to
# Claude's web connector callbacks.
# MAIL_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Pin the Host headers accepted by the MCP endpoint (comma-separated). Left
# empty, DNS-rebinding protection is off and OAuth is the only gate, which is
# what you want behind a reverse proxy.
# MAIL_ALLOWED_HOSTS=mail-mcp.example.com

# Log level: DEBUG, INFO (default), WARNING, ERROR.
# MAIL_LOG_LEVEL=INFO

# --- Activity log (the /logs view) -----------------------------------------
# Every MCP tool call is recorded: when, which connector, which mailbox, which
# tool, the arguments worth auditing (subjects, recipients, folders, UIDs) and
# how it ended. Message bodies, attachments and credentials are never written.

# Where the JSONL file lives (default: next to the store).
# MAIL_ACTIVITY_LOG=/data/mail_activity.jsonl

# How many entries to keep; the file is trimmed to the most recent ones.
# Set to 0 to turn the activity log off entirely.
# MAIL_ACTIVITY_MAX_ENTRIES=5000


# =============================================================================
# Single-mailbox mode (docker compose --profile single up, or `mail-mcp` over
# stdio). Only used by those profiles; the multi-user service ignores them.
# =============================================================================

# MAIL_ADDRESS=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_IMAP_HOST=imap.example.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SECURITY=ssl          # ssl | starttls | none
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURITY=starttls     # ssl | starttls | none

# Optional refinements.
# MAIL_FROM_NAME=Ada Lovelace
# MAIL_LABEL=work
# MAIL_IMAP_USERNAME=            # defaults to MAIL_ADDRESS
# MAIL_SMTP_USERNAME=            # defaults to MAIL_ADDRESS
# MAIL_VERIFY_SSL=true           # false only for a local bridge (Proton)
# MAIL_READ_ONLY=false           # true: the agent can read but never write
# MAIL_TIMEOUT=30

# Several mailboxes at once: a JSON file holding a list of account objects
# (same field names as above, lowercase, with "password"). It is read in
# addition to the single mailbox defined above.
# MAIL_ACCOUNTS_FILE=/data/accounts.json
# MAIL_DEFAULT_ACCOUNT=you@example.com

# --- XOAUTH2 instead of a password (Gmail, Microsoft 365) ------------------
# MAIL_AUTH=xoauth2
# MAIL_OAUTH_PROVIDER=google      # google | microsoft
# MAIL_REFRESH_TOKEN=
# MAIL_OAUTH_CLIENT_ID=
# MAIL_OAUTH_CLIENT_SECRET=
# MAIL_OAUTH_TENANT=common        # Microsoft directory tenant
